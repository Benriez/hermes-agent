  "workflow_policy_checks": [
    "parent_orchestration_card_done_after_decomposition",
    "formal_review_cards_use_review_status_not_ready",
    "minimax_implementer_not_routed_through_implementation_dispatch",
    "dispatcher_required_skills_available_before_review_start",
    "optional_review_skills_availability_guarded_before_dispatch",
    "no_direct_sqlite_except_authorized_rescue_artifact",
    "intake_parent_created_with_initial_status_blocked",
    "intake_parent_runtime_skills_contain_only_prism_full",
    "intake_parent_workflow_skill_in_body_metadata_not_card_skills_field",
    "close_gate_accepts_run_metadata_as_review_evidence",
    "scratch_workspace_cleanup_is_warning_not_failure"
  ]
