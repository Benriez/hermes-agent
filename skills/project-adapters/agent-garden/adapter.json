  "workers": {
    "implementation": "deep-implementer",
    "review": "minimax-implementer"
  },
  "required_skills": [
    "prism-full"
  ],
  "required_prism_context": "superhermes",
  "verification": {
    "tests": [
      "pytest supervisor/tests/test_config.py -q",
      "pytest supervisor/tests/test_runtime_safety_hardening.py -q",
      "pytest supervisor/tests/ -q"
    ],
    "browser": {
      "required_if_ui": true,
      "url": "http://localhost:4200/w/default/desktop"
    },
    "dev_server": {
      "command": "WORKSPACE_ROOT=/Users/benny/Code/agent-garden PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH npm start"
    },
    "ui_file_detection_patterns": [
      "\\.tsx$",
      "\\.ts$",
      "\\.jsx$",
      "\\.css$",
      "\\.scss$"
    ]
  },
  "close_gate": {
    "commit_push_before_close": true,
    "review_evidence_required": true,
    "remote_commit_verification_required": true
  },
  "artifact_paths": {
    "root": "/home/flashback/.hermes/artifacts"
  },
  "wiki_paths": {
    "project": "/home/flashback/.hermes/workspace/llm-wiki/wiki/projects/agent-garden"
  },
  "known_failure_modes": [
    "close before commit + push",
    "parent spawned on Mac repo path",
    "missing auditable review evidence",
    "review assigned away from minimax-implementer",
    "parent auto-done before child REVIEW_PASS",
    "review card left ready for minimax-implementer instead of review status",
    "review dispatch crash when sdlc-review skill is unavailable",
    "direct SQLite transition used outside explicit rescue authorization",
    "intake parent created ready and auto-dispatched with unknown worker skills kanban-card-spec and kanban-watch",
    "kanban workflow skills placed in card skills field instead of body metadata"
  ],
  "examples": [
    "issue-48-success",
    "examples/issue-51-review-dispatch-learning.json"
  ],
  "dispatch_policy": {
    "ready_status_path": "implementation_dispatch",
    "review_status_path": "formal_review_claim_review_task",
    "review_status_required_for_minimax": true,
    "minimax_implementation_dispatch_allowed": false
  }
}
