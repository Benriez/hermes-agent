{
  "project_id": "agent-garden",
  "display_name": "Agent Garden",
  "github_repo": "Benriez/agent-garden",
  "board_name": "agent-garden",
  "default_branch": "bodi",
  "source_host": "mac",
  "repo_path_by_host": {
    "mac": "/Users/benny/Code/agent-garden",
    "pi": null,
    "windows": null
  },
  "host_targets": {
    "mac": "benny-mac",
    "pi": "rpi4",
    "windows": null
  },
  "execution_host_policy": {
    "orchestrator_host": "pi",
    "source_edit_host": "mac",
    "parent_workspace": "pi_scratch",
    "child_workspace": "pi_scratch",
    "source_repo_access": "pi_to_mac_ssh_or_computer_use",
    "host_routing_rules": [
      "Do not use /Users/benny/Code/agent-garden as parent workspace",
