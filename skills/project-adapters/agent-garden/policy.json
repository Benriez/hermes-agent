{
  "policy_id": "agent-garden-stage2-policy",
  "version": "1.1",
  "policy_inheritance": {
    "universal_policy": "skills/kanban/shared/universal-stage2-policy.json",
    "inherits_close_gate": true,
    "inherits_parent_card_semantics": true,
    "inherits_forbidden_assignees": true,
    "inherits_runtime_skill_rules": true,
    "adapter_specializations": {
      "close_gate": "adapter may add project-specific warnings (e.g. remote target verification for Agent Garden remotes)",
      "workers": "concrete worker names (deep-implementer, minimax-implementer) belong to adapter policy",
      "review_worker": "Agent Garden: minimax-implementer",
      "implementation_worker": "Agent Garden: deep-implementer"
    }
  },
  "inherits": "skills/kanban/shared/universal-stage2-policy.json",
  "project_id": "agent-garden",
  "mandatory_skills": [
    "prism-full"
  ],
  "review_worker": "minimax-implementer",
  "implementation_worker": "deep-implementer",
  "close_gate": {
    "commit_push_before_close": true,
    "review_evidence_required": true,
    "remote_commit_verification_required": true,
    "accepted_review_evidence_sources": [
      "review_artifact_json",
      "review_report_txt",
      "kanban_run_metadata_review_passed",
      "review_agent_log",
      "review_watch_artifact"
    ],
    "scratch_workspace_cleanup_is_warning_not_failure": true,
    "github_issue_number_null_close_not_applicable": true,
    "remote_target_must_be_task_specific": true,
    "close_gate_pass_with_warnings_allowed": true
  },
  "dispatch_semantics": {
    "implementation_status": "ready",
    "formal_review_status": "review",
    "review_worker": "minimax-implementer",
    "review_worker_must_not_use_implementation_dispatch": true
  },
  "intake_parent_policy": {
    "initial_status_must_be_blocked": true,
    "must_not_auto_dispatch": true,
    "runtime_worker_skills_only": true,
    "card_skills_field_means_worker_runtime_skills": true,
    "allowed_runtime_worker_skills": ["prism-full"],
    "forbidden_runtime_worker_skills": [
      "kanban-card-spec",
      "kanban-watch",
      "kanban-review",
      "kanban-close-gate"
    ],
    "workflow_skill_in_body": "kanban-card-spec",
    "operator_skills_used_in_body": ["kanban-card-spec", "kanban-watch"],
    "required_worker_skills_in_body": ["prism-full"],
    "canonical_create_command": "hermes kanban --board agent-garden create --title 'Stage 1 Intake — <issue>' --initial-status blocked --skills prism-full --body '<body with workflow metadata>'"
  },
  "rescue_policy": {
    "direct_sqlite_forbidden_in_normal_workflow": true,
    "direct_sqlite_allowed_only_with_explicit_operator_rescue_and_artifact": true,
    "official_cli_transition_required": true
  },
  "skill_availability": {
    "review_dispatch_required_skills_must_be_available": true,
    "optional_review_skills_must_be_availability_guarded": true,
    "known_incidents": [
      "issue-51-run-88-sdlc-review-missing",
      "issue-t_50dd31da-run-90-kanban-card-spec-kanban-watch-unknown"
    ]
  },
  "worker_validation": {
    "universal_validator_adapter_driven": true,
    "adapter_declares_workers": true,
    "implementation_worker": "deep-implementer",
    "review_worker": "minimax-implementer"
  },
  "role_separation": {
    "gitter_role_explicit_for_commit_push": true
  },
  "documentation": {
    "gotchas_first_class": true,
    "progressive_disclosure_required": true,
    "trigger_descriptions_required": true,
    "skill_examples_are_incident_memory": true,
    "deterministic_scripts_preferred_for_gates": true
  }
}
