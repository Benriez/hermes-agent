{
  "policy_id": "universal-kanban-stage2-policy",
  "version": "1.2",
  "required_prism_context": "superhermes",
  "mandatory_prism_full_when_adapter_requires": true,
  "forbidden_assignees": [
    "superhermes",
    "local-implementer",
    "local-reviewer"
  ],
  "hosts": {
    "pi": "orchestration/artifacts/wiki/kanban",
    "mac": "default source-edit host",
    "windows": "windows-only source-edit host"
  },
  "close_gate": {
    "commit_push_before_close": true,
    "review_evidence_required": true,
    "remote_commit_verification_required": true,
    "accepted_review_evidence_sources": [
      "review_artifact_json",
      "review_report_txt",
      "kanban_run_metadata_review_passed",
      "review_agent_log",
      "review_watch_artifact"
    ],
    "scratch_workspace_cleanup_is_warning_not_failure": true,
    "github_issue_number_null_close_not_applicable": true,
    "remote_target_must_be_task_specific": true,
    "close_gate_pass_with_warnings_allowed": true,
    "implementation_persistence_evidence_required_when_changes_expected": true,
    "implementation_completed_but_no_persisted_changes_blocks_close_gate": true,
    "close_gate_accepts_no_change_task_success_only_when_explicit": true
  },
  "safety": {
    "no_direct_sqlite_writes": true,
    "no_issue_close_without_gate": true,
    "no_source_host_paths_as_parent_workspace": true
  },
  "parent_cards": {
    "orchestration_only": true,
    "complete_after_successful_decomposition": true,
    "parent_done_means_orchestration_setup_complete_not_issue_complete": true,
    "child_execution_depends_on_parent_done": true
  },
  "intake_parent_cards": {
    "initial_status_must_be_blocked": true,
    "must_not_auto_dispatch": true,
    "spawnable_assignee_forbidden": true,
    "runtime_worker_skills_only": true,
    "workflow_skill_metadata_required": true,
    "operator_skills_used_metadata_required": true,
    "card_skills_field_means_worker_runtime_skills": true,
    "allowed_runtime_worker_skills_for_intake_parent": [
      "prism-full"
    ],
    "forbidden_runtime_worker_skills_for_intake_parent": [
      "kanban-card-spec",
      "kanban-watch",
      "kanban-review",
      "kanban-close-gate"
    ],
    "workflow_skill_field": "workflow_skill",
    "operator_skills_used_field": "operator_skills_used",
    "required_worker_skills_field": "required_skills"
  },
  "dispatch_semantics": {
    "ready_status_path": "implementation_dispatch",
    "review_status_path": "formal_review_claim_review_task",
    "implementation_complete_requiring_review_must_transition_to": "review",
    "do_not_set_review_assignee_card_to_ready": true
  },
  "review_worker": {
    "adapter_review_worker_review_only_by_default": true,
    "do_not_route_adapter_review_worker_through_implementation_dispatch": true,
    "review_workers_must_use_formal_review_status": true,
    "implementation_dispatch_must_not_select_adapter_declared_review_worker": true,
    "require_explicit_review_pass_or_fail": true,
    "concrete_review_worker_names_belong_to_project_adapter": true,
    "review_must_verify_actual_file_content_or_diff": true,
    "worker_summary_alone_must_not_pass_review": true,
    "review_must_fail_expected_writes_with_zero_persisted_changes": true
  },
  "sqlite_policy": {
    "normal_workflow_direct_sqlite_forbidden": true,
    "rescue_requires_explicit_authorization_and_artifact": true,
    "normal_workflow_requires_official_cli_status_transitions": true
  },
  "skill_availability": {
    "dispatcher_required_skills_checked_before_run_start": true,
    "hardcoded_skill_requirements_must_be_guarded": true,
    "optional_review_skills_must_be_availability_guarded": true,
    "known_incidents": [
      "issue-51-run-88-sdlc-review-missing",
      "issue-t_50dd31da-run-90-kanban-card-spec-kanban-watch-unknown"
    ]
  },
  "role_separation": {
    "gitter_role_explicit_for_commit_push": true
  },
  "documentation": {
    "gotchas_first_class": true,
    "progressive_disclosure_required": true,
    "trigger_descriptions_required": true,
    "skill_examples_are_incident_memory": true,
    "deterministic_scripts_preferred_for_gates": true
  },
  "worker_validation": {
    "universal_validator_must_not_hardcode_worker_names": true,
    "concrete_worker_names_belong_to_project_adapter": true,
    "universal_validator_validates_only_forbidden_assignees": true,
    "adapter_declares_implementation_and_review_workers": true,
    "validate_parent_card_script_is_adapter_driven": true
  },
  "plan_gate": {
    "plan_gate_required_before_implementation_dispatch": true,
    "plan_gate_must_define_verification_strategy": true,
    "plan_gate_must_define_forbidden_actions": true,
    "plan_gate_must_define_success_criteria": true,
    "plan_gate_must_use_worker_roles_not_concrete_workers": true,
    "plan_gate_adapter_specifics_must_be_in_adapter_context": true,
    "plan_gate_dispatch_decision_must_be_explicit": true
  },
  "partition_check": {
    "partition_check_required_before_parallel_dispatch": true,
    "partition_check_must_define_write_scope": true,
    "partition_check_must_block_write_write_conflicts": true,
    "partition_check_must_block_exclusive_lock_conflicts": true,
    "partition_check_must_warn_on_write_read_overlap": true,
    "partition_check_unknown_scope_requires_operator_approval": true,
    "partition_check_adapter_specifics_must_be_in_adapter_context": true,
    "partition_check_decision_must_be_explicit": true
  },
  "gitter": {
    "gitter_required_before_close_gate_when_commit_expected": true,
    "gitter_must_use_explicit_commit_scope": true,
    "gitter_must_preserve_unrelated_dirty_files": true,
    "gitter_must_not_force_push": true,
    "gitter_must_not_close_github_issues_without_operator_approval": true,
    "gitter_must_not_create_pr_or_merge_without_operator_approval": true,
    "gitter_must_not_direct_sqlite": true,
    "gitter_remote_target_is_task_or_adapter_specific": true,
    "gitter_artifact_or_wiki_commit_requires_explicit_allowance": true,
    "gitter_decision_must_be_explicit": true,
    "gitter_uses_explicit_staging_only": true,
    "gitter_blocks_expected_changes_with_empty_actual_diff": true,
    "gitter_allows_empty_diff_only_for_explicit_no_commit_or_read_only_task": true
  },
  "implementation_persistence": {
    "implementation_completion_requires_durable_evidence": true,
    "worker_summary_is_not_sufficient_evidence": true,
    "expected_write_paths_require_actual_target_repo_changes": true,
    "zero_diff_in_allowed_paths_blocks_when_writes_expected": true,
    "explicit_no_change_task_classification_required_for_zero_diff_success": true,
    "implementation_completed_but_no_persisted_changes_is_failure": true,
    "accepted_success_classifications": [
      "implementation_success_with_persisted_changes",
      "no_change_task_success"
    ],
    "failure_classification": "implementation_completed_but_no_persisted_changes"
  }
}
