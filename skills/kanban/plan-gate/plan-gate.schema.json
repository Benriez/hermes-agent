{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes Kanban Plan Gate",
  "type": "object",
  "required": [
    "plan_gate"
  ],
  "properties": {
    "plan_gate": {
      "type": "object",
      "required": [
        "problem_statement",
        "operator_intent",
        "success_criteria",
        "non_goals",
        "forbidden_actions",
        "scope",
        "adapter_context",
        "execution_plan",
        "verification_strategy",
        "risk_assessment",
        "dispatch_decision"
      ],
      "properties": {
        "problem_statement": {
          "type": "string",
          "minLength": 1
        },
        "operator_intent": {
          "type": "string",
          "minLength": 1
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "object",
          "required": [
            "allowed_paths",
            "forbidden_paths",
            "affected_systems"
          ],
          "properties": {
            "allowed_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "forbidden_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "affected_systems": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "adapter_context": {
          "type": "object",
          "required": [
            "adapter",
            "project",
            "repo_path",
            "issue"
          ],
          "properties": {
            "adapter": {
              "type": [
                "string",
                "null"
              ]
            },
            "project": {
              "type": [
                "string",
                "null"
              ]
            },
            "repo_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "issue": {
              "type": [
                "string",
                "integer",
                "null"
              ]
            }
          }
        },
        "execution_plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_strategy": {
          "type": "object",
          "required": [
            "commands",
            "manual_checks",
            "evidence_expected"
          ],
          "properties": {
            "commands": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "manual_checks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_expected": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "risk_assessment": {
          "type": "object",
          "required": [
            "risk_level",
            "known_risks",
            "rollback_or_recovery"
          ],
          "properties": {
            "risk_level": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "known_risks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rollback_or_recovery": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "dispatch_decision": {
          "type": "object",
          "required": [
            "ready_for_implementation",
            "required_worker_role",
            "requires_operator_approval",
            "reason"
          ],
          "properties": {
            "ready_for_implementation": {
              "type": "boolean"
            },
            "required_worker_role": {
              "type": [
                "string",
                "null"
              ]
            },
            "requires_operator_approval": {
              "type": "boolean"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
